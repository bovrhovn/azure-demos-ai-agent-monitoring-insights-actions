{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "ApplicationInsights": {
      "LogLevel": { "Default": "Warning", "AgentOps": "Information" }
    }
  },
  "AllowedHosts": "localhost",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "OperatorRole": "AgentOps.Operator",
    "ReaderRole": "AgentOps.Reader",
    "RunScope": "Agent.Run"
  },
  "ApplicationInsights": { "ConnectionString": "" },
  "Insights": { "ResourceId": "", "LookbackMinutes": 60, "LogLimit": 50 },
  "InsightsTools": {
    "Enabled": true,
    "DefaultLookbackMinutes": 60,
    "MaxLookbackMinutes": 10080,
    "DefaultCount": 5,
    "MaxRows": 20,
    "QueryTimeoutSeconds": 30,
    "MaxToolCalls": 6,
    "MaxResultCharacters": 16000,
    "MaxFieldCharacters": 4000,
    "MaxEvidenceReferences": 100
  },
  "Cosmos": {
    "Endpoint": "",
    "Database": "agentops",
    "Container": "executions",
    "InitializeDatabase": false,
    "AllowInsecureEmulatorTls": false
  },
  "Scheduling": {
    "Enabled": true,
    "RecurringJobId": "insights-agent",
    "Cron": "*/15 * * * *"
  },
  "Executions": {
    "HistoryLimit": 50,
    "TimeoutSeconds": 120,
    "FinalizationTimeoutSeconds": 15,
    "RequestsPerMinute": 10
  },
  "Chat": {
    "Container": "chats",
    "SessionPageSize": 30,
    "MessagePageSize": 40,
    "HistoryLimit": 40,
    "MaxPromptLength": 8000,
    "MaxOutputTokens": 2048,
    "RequestsPerMinute": 20,
    "TimeoutSeconds": 120,
    "FinalizationTimeoutSeconds": 15
  },
  "Notifications": {
    "Container": "notifications",
    "PageSize": 20,
    "MaxSearchLength": 200,
    "MaxCommentLength": 2000
  },
  "Foundry": { 
    "ProjectEndpoint": "", 
    "ModelDeployment": "gpt-5.5", 
    "AgentName": "insights-agent" 
  },
  "Hosting": {
    "BehindContainerAppsIngress": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  }
}
